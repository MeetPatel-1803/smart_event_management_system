<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <meta name='x-apple-disable-message-reformatting' />
    <title>Welcome to Smart Events!</title>
  </head>

  <body
    style='margin:0; padding:0; background-color:#F5F7FB; font-family:Arial, Helvetica, sans-serif; color:#1F2937;'
  >

    <table
      role='presentation'
      width='100%'
      cellspacing='0'
      cellpadding='0'
      border='0'
      style='width:100%; margin:0; padding:0; background-color:#F5F7FB;'
    >
      <tr>
        <td align='center' style='padding:32px 16px;'>

          <table
            role='presentation'
            width='600'
            cellspacing='0'
            cellpadding='0'
            border='0'
            style='width:100%; max-width:600px; background-color:#FFFFFF; border:1px solid #E5E7EB; border-radius:10px; box-shadow:0 2px 8px rgba(15,23,42,0.06); overflow:hidden;'
          >

            <!-- Header -->
            <tr>
              <td
                align='center'
                style='padding:28px 32px; background-color:#4F46E5;'
              >
                <div
                  style='font-size:24px; line-height:32px; font-weight:700; color:#FFFFFF;'
                >
                  Smart Events
                </div>
              </td>
            </tr>

            <!-- Body -->
            <tr>
              <td style='padding:40px 40px 32px 40px;'>

                <h1
                  style='margin:0 0 24px 0; font-size:28px; line-height:36px; font-weight:700; color:#111827;'
                >
                  Welcome to Smart Events!
                </h1>

                <p
                  style='margin:0 0 16px 0; font-size:16px; line-height:26px; color:#374151;'
                >
                  Hi
                  {{userName}},
                </p>

                <p
                  style='margin:0 0 16px 0; font-size:16px; line-height:26px; color:#374151;'
                >
                  Thank you for creating your Smart Events account. We're
                  excited to have you with us!
                </p>

                <p
                  style='margin:0 0 24px 0; font-size:16px; line-height:26px; color:#374151;'
                >
                  Smart Events makes it easy to discover, register for, and
                  manage events all in one place.
                </p>

                <!-- Capabilities -->
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  border='0'
                  style='margin:0 0 28px 0;'
                >
                  <tr>
                    <td
                      style='padding:16px 18px; background-color:#F9FAFB; border:1px solid #E5E7EB; border-radius:8px;'
                    >

                      <p
                        style='margin:0 0 12px 0; font-size:16px; line-height:24px; font-weight:700; color:#111827;'
                      >
                        With Smart Events, you can:
                      </p>

                      <table
                        role='presentation'
                        width='100%'
                        cellspacing='0'
                        cellpadding='0'
                        border='0'
                      >
                        <tr>
                          <td
                            valign='top'
                            style='padding:5px 0; font-size:15px; line-height:22px; color:#4B5563;'
                          >
                            <span
                              style='color:#4F46E5; font-weight:700;'
                            >&#10003;</span>&nbsp;&nbsp;Discover upcoming events
                          </td>
                        </tr>
                        <tr>
                          <td
                            valign='top'
                            style='padding:5px 0; font-size:15px; line-height:22px; color:#4B5563;'
                          >
                            <span
                              style='color:#4F46E5; font-weight:700;'
                            >&#10003;</span>&nbsp;&nbsp;Register for events
                          </td>
                        </tr>
                        <tr>
                          <td
                            valign='top'
                            style='padding:5px 0; font-size:15px; line-height:22px; color:#4B5563;'
                          >
                            <span
                              style='color:#4F46E5; font-weight:700;'
                            >&#10003;</span>&nbsp;&nbsp;Manage event
                            registrations
                          </td>
                        </tr>
                        <tr>
                          <td
                            valign='top'
                            style='padding:5px 0; font-size:15px; line-height:22px; color:#4B5563;'
                          >
                            <span
                              style='color:#4F46E5; font-weight:700;'
                            >&#10003;</span>&nbsp;&nbsp;Receive event reminders
                            and updates
                          </td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>

                <!-- CTA -->
                <table
                  role='presentation'
                  cellspacing='0'
                  cellpadding='0'
                  border='0'
                  align='center'
                  style='margin:0 auto 28px auto;'
                >
                  <tr>
                    <td
                      align='center'
                      bgcolor='#4F46E5'
                      style='border-radius:7px;'
                    >
                      <a
                        href='{{eventsUrl}}'
                        target='_blank'
                        style='display:inline-block; padding:14px 28px; font-size:16px; line-height:24px; font-weight:700; color:#FFFFFF; text-decoration:none; background-color:#4F46E5; border:1px solid #4F46E5; border-radius:7px;'
                      >
                        Explore Events
                      </a>
                    </td>
                  </tr>
                </table>

                <!-- Helpful Message -->
                <table
                  role='presentation'
                  width='100%'
                  cellspacing='0'
                  cellpadding='0'
                  border='0'
                >
                  <tr>
                    <td
                      style='padding:16px 18px; background-color:#EEF2FF; border-left:4px solid #4F46E5; border-radius:4px;'
                    >
                      <p
                        style='margin:0; font-size:15px; line-height:24px; color:#3730A3;'
                      >
                        You're all set! Start exploring events and find
                        something you'll love.
                      </p>
                    </td>
                  </tr>
                </table>

              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td
                align='center'
                style='padding:24px 32px; background-color:#F9FAFB; border-top:1px solid #E5E7EB;'
              >

                <p
                  style='margin:0 0 8px 0; font-size:13px; line-height:20px; color:#6B7280;'
                >
                  Need help? Contact us at
                  <a
                    href='mailto:{{supportEmail}}'
                    style='color:#4F46E5; text-decoration:none;'
                  >
                    {{supportEmail}}
                  </a>
                </p>

                <p
                  style='margin:0; font-size:13px; line-height:20px; color:#9CA3AF;'
                >
                  ©
                  {{year}}
                  Smart Events. All rights reserved.
                </p>

              </td>
            </tr>

          </table>

        </td>
      </tr>

    </table>

  </body>
</html>